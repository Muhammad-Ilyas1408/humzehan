# Copy to backend/.env and fill in real values. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
AGENT_MAX_LOOPS=2
DATABASE_PATH=humzehan.db
# Maximum length of the source text for one lesson (characters)
MAX_SOURCE_CHARS=8000
# Model that reads text from photos (must support images); empty = same as LLM_MODEL
VISION_MODEL=
# Maximum photo upload size (bytes); default 10 MB
MAX_IMAGE_BYTES=10485760
